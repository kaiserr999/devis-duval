# Copier ce fichier en .env puis remplir les valeurs.
# .env n'est jamais versionné (voir .gitignore).

# Clé secrète Flask (sessions, CSRF). Obligatoire hors mode debug.
# Générer une clé : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Point d'entrée pour la commande flask (db upgrade, seed, creer-gerant)
FLASK_APP=run.py

# Active le mode debug (rechargement auto, clé de dev autorisée). 0 en production.
FLASK_DEBUG=1

# Cookie de session envoyé seulement en HTTPS : 1 en production
SESSION_COOKIE_SECURE=0

# 1 si un proxy HTTPS (Render...) est devant l'application
DERRIERE_PROXY=0

# --- Utilisés seulement au démarrage du conteneur Docker ---
# 1 : insère les clients et devis de démo si la base est vide
SEED_DEMO=0
# Compte du gérant créé (ou mot de passe remis) au démarrage
# GERANT_EMAIL=gerant@duval.fr
# GERANT_MOT_DE_PASSE=

# --- Emails aux clients (devis envoyé, invitation à l'espace client) ---
# Sans MAIL_SERVER, l'email n'est PAS envoyé : il est affiché dans le
# terminal, et le lien du client s'affiche aussi dans la page.
# Exemple Gmail : MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, et un
# « mot de passe d'application » dans MAIL_PASSWORD.
# MAIL_SERVER=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# Adresse d'expédition (par défaut : l'email de l'entreprise, app/config.py)
# MAIL_EXPEDITEUR=

# Base de données (optionnel, SQLite dans instance/devis.db par défaut)
# DATABASE_URL=sqlite:///chemin/vers/devis.db
